# jev-qq-analyst 当前配置示例
# 建议复制所需行到 ~/.config/jev-jarvis/env；旧配置路径仍由启动器使用。
# 开发时也可在项目根目录使用 .env（已被 .gitignore 排除）。

# Decision Infra 网关；默认值已是 http://127.0.0.1:8080 / jev-latest。
# 模型 ID 是精确路由；网关未注册时应用报错，不自动更换模型。
DECISION_INFRA_BASE_URL=http://127.0.0.1:8080
DECISION_INFRA_MODEL=jev-latest

# 可选：启动时显示 QQ 消息定位框；菜单栏可切换。
#JEV_BOXES=1

# TYPESAFE_API_KEY 及其他 Provider 凭据只配置在 Decision Infra，
# 不放入本项目的 env 文件。
